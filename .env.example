# =============================================================================
# Physiosis BioKinematic AI — Environment Configuration
# =============================================================================

# ── Local Ollama Biomechanics Assistant ─────────────────────────────────────
# The local base URL where Ollama is running (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Name of the local model installed via `ollama pull <model-name>`
# Examples: llama3.2, llama3.1, phi3, mistral, gemma2, qwen2.5
OLLAMA_MODEL=llama3.2

# ── Supabase Cloud Persistence (Optional for Demo) ──────────────────────────
# If configured, authenticated patient sessions will automatically sync.
# In local demo mode, sessions are stored in browser localStorage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
